  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model EmailTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  subject   String
  html      String   @db.Text
  updatedAt DateTime @updatedAt
}

// ---------- Phase 11: Blog ----------

enum BlogPostStatus {
