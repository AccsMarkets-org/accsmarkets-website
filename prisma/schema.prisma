  name        String   @unique
  description String?
  permissions Json // string[] of permission constants
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users   User[]
  invites StaffInvite[]
}

model StaffInvite {
  id          String     @id @default(cuid())
  email       String     @unique
  staffRoleId String?
  staffRole   StaffRole? @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  invitedById String
  invitedBy   User       @relation("StaffInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([email])
}

// ---------- AutoSEO content sync ----------

model AutoSeoArticle {
  autoSeoId             Int      @id
  blogPostId            String   @db.VarChar(191)
  slug                  String   @db.VarChar(191)
  languageCode          String?  @db.VarChar(16)
  sourceArticleId       Int?
  publishedUrl          String?  @db.Text
  metaDescription       String?  @db.Text
  metaKeywords          String?  @db.Text
  keywords              String?  @db.Text
  faqSchema             String?  @db.LongText
  contentHtml           String?  @db.LongText
  contentMarkdown       String?  @db.LongText
  heroImageUrl          String?  @db.Text
  heroImageLocal        String?  @db.Text
  heroImageAlt          String?  @db.Text
  infographicImageUrl   String?  @db.Text
  infographicImageLocal String?  @db.Text
  deliveryId            String?  @db.VarChar(191)
  rawPayload            String?  @db.LongText
  createdAt             DateTime @default(now()) @db.DateTime(3)
  updatedAt             DateTime @default(now()) @updatedAt @db.DateTime(3)

  @@index([blogPostId], map: "idx_autoseo_blogpost")
  @@index([slug], map: "idx_autoseo_slug")
  @@map("AutoSeoArticle")
}

// ---------- Contact Inquiries ----------

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String    @db.Text
  ip        String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  readById  String?
  createdAt DateTime  @default(now())

  @@index([isRead, createdAt])
}

// ---------- Support Tickets ----------

model SupportTicket {
  id          String                 @id @default(cuid())
  number      Int                    @unique @default(autoincrement())
  userId      String
  user        User                   @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subject     String
  category    SupportTicketCategory  @default(OTHER)
  priority    SupportTicketPriority  @default(NORMAL)
  status      SupportTicketStatus    @default(OPEN)
  // Optional link to the thing the ticket is about.
  escrowId    String?
  listingId   String?
  lastReplyAt DateTime               @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  messages    SupportTicketMessage[]

  @@index([userId, status])
  @@index([status, lastReplyAt])
  @@index([assigneeId])
}

model SupportTicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isStaff     Boolean       @default(false)
  isInternal  Boolean       @default(false) // staff-only note, hidden from the user
  body        String        @db.Text
  attachments Json? // string[] of upload URLs
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
}
