  @@index([userId])
}

// ---------- Phase 6: KYC & Identity ----------

// A real, WhatsApp-verified phone number — used to gate listing/buying/chat
// (see src/lib/phone-gate.ts). Previously this same table was ALSO reused by
// the identity-verification email-OTP step (storing the user's email address
// in `phoneNumber` as a workaround for not having an SMS/WhatsApp provider),
// which meant the two flows clobbered each other's `verifiedAt`/`phoneNumber`
// on every send/confirm. That step now uses EmailOtpVerification instead.
model PhoneVerification {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// Email-OTP step of the identity-verification (KYC) stepper — split out from
// PhoneVerification, which it used to (incorrectly) share.
model EmailOtpVerification {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Records one send per (user, campaign) — dedup + cooldown enforcement for
// the automated re-engagement sweep (src/app/api/internal/marketing-sweep).
// `campaign` values: "new_signup_nudge" | "inactive_winback" | "offer_abandoned".
model MarketingEmailLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign String
  sentAt   DateTime @default(now())

  @@index([userId, campaign])
}

model KycSubmission {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  idFrontUrl      String
  idBackUrl       String
  selfieUrl       String
  ocrName         String?
  ocrDob          String?
  ocrDocNumber    String?
  ocrExpiry       String?
  kycScore        Float?
  isLive          Boolean?
  faceSimilarity  Float?
  status          String    @default("PENDING") // PENDING | UNDER_REVIEW | APPROVED | REJECTED
  rejectionReason String?   @db.Text
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?

  @@index([userId])
  @@index([status])
}

