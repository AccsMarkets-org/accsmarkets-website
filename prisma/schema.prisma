enum PromoCodeType {
  PERCENT_OFF_FEE
  FLAT_CREDIT
}

model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique
  type            PromoCodeType
  value           Decimal           @db.Decimal(12, 2)
  maxRedemptions  Int?
  redemptionCount Int               @default(0)
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  redemptions     PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime  @default(now())
  // Set when the discount is actually applied to an escrow. The row itself is
  // the anti-replay mechanism (via the unique constraint below) — it used to
  // be deleted on use, which removed that same constraint and let a user
  // redeem the identical code again. Marking it consumed instead of deleting
  // it keeps the row (and the constraint) alive permanently.
  consumedAt  DateTime?

  @@unique([promoCodeId, userId])
  @@index([userId])
}

// ---------- Payments Expansion ----------

model FiatPayment {
