// ---------- Fraud & Risk Management ----------

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model DeviceFingerprint {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([fingerprintHash])
  @@index([userId])
}

model RiskScore {
  id          String       @id @default(cuid())
  userId      String       @unique
  score       Int          @default(0) // 0–100
  severity    RiskSeverity @default(LOW)
  factors     Json // [{ rule: string, weight: number, detail: string }]
  computedAt  DateTime     @default(now())
  dismissedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([severity])
}

model SecurityFlag {
  id         String       @id @default(cuid())
  userId     String
  source     String // "auto_risk" | "rate_limit" | "moderator" | etc.
  severity   RiskSeverity @default(MEDIUM)
  reason     String       @db.Text
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([severity, resolvedAt])
}

