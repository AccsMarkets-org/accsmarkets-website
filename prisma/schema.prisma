  responseStatus Int?
  responseBody   String?               @db.Text
  attempts       Int                   @default(0)
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())

  @@index([endpointId])
  @@index([status])
}

