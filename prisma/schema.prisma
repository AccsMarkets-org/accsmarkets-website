generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  USER
  ADMIN
}

enum KycLevel {
  NONE
  EMAIL
  PHONE
  ID_VERIFIED
}

enum VerifiedBadge {
  NONE
  BLUE
  GOLD
  GREY
  OFFICIAL
}

enum Platform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  FACEBOOK
  TELEGRAM
  TWITTER_X
  SNAPCHAT
  PINTEREST
  LINKEDIN
  WEBSITE
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  SOLD
  REJECTED
  SUSPENDED
  EXPIRED
}

enum SupportTicketStatus {
  OPEN
  AWAITING_USER
  AWAITING_STAFF
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketCategory {
  ACCOUNT
  PAYMENT
  ESCROW
  LISTING
  KYC
  TECHNICAL
  OTHER
}

enum AdsenseStatus {
  ON
  OFF
  CHANGEABLE
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  COUNTERED
  CANCELLED
}

enum EscrowStatus {
  FUNDED
  AWAITING_MANAGER_ADD
  PENDING_VERIFICATION
  SUBMITTED
  VERIFIED
  IN_TRANSFER
  COMPLETED
  CANCELLED
  DISPUTED
}

enum TransferModel {
  STANDARD
  TRUSTLESS
}

enum EscrowManagerEmailStatus {
  AVAILABLE
  IN_USE
  FLAGGED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

enum DisputePhase {
  EVIDENCE
  REVIEW
  MEDIATION
  RULING
  APPEAL
  FINAL
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_PAYMENT
  ESCROW_RELEASE
  PLATFORM_FEE
  REFUND
  WALLET_CREDIT
  WALLET_DEBIT
  PROMOTION
  BUMP
  SUBSCRIPTION
}

enum PromotionType {
  FEATURED_BOOST
  PREMIUM_FEATURED
  PINNED
  BUMP
}

enum AchievementBadgeType {
  RISING_STAR
  POWER_SELLER
  TOP_SELLER
  LEGEND
  BIG_EARNER
  WHALE
  FIVE_STAR_SELLER
  FAST_RESPONDER
  TRUSTED_SELLER
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
}

enum AnnouncementAudience {
  ALL
  BUYER
  SELLER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  LISTING
  LISTING_APPROVED
  LISTING_REJECTED
  OFFER
  ESCROW
  MESSAGE
  PAYMENT
  DEPOSIT_CONFIRMED
  SYSTEM
  DISPUTE
  SECURITY
}

enum ReportReason {
  SCAM
  FAKE_ACCOUNT
  INAPPROPRIATE_CONTENT
  SPAM
  HARASSMENT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
}

// M4 enums
enum SaleType {
  FIXED
  AUCTION
}

enum WantedListingStatus {
  OPEN
  FULFILLED
  CLOSED
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum KybStatus {
  NONE
  SUBMITTED
  APPROVED
  REJECTED
}

enum BankTransferStatus {
  PENDING
  SENT
  VERIFIED
  REJECTED
  EXPIRED
}

// ---------- NextAuth models ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain models ----------

model User {
  id                            String            @id @default(cuid())
  email                         String            @unique
  emailVerified                 DateTime?
  password                      String? // null for OAuth-only accounts
  name                          String?
  username                      String?           @unique
  image                         String?
  coverPhoto                    String? // Cloudinary URL for profile cover banner
  role                          Role              @default(USER)
  kycLevel                      KycLevel          @default(NONE)
  verifiedBadge                 VerifiedBadge     @default(NONE)
  trustScore                    Int               @default(0)
  walletBalance                 Decimal           @default(0) @db.Decimal(12, 2)
  subscriptionPlanId            String?
  subscriptionPlan              SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionExpiresAt         DateTime?
  // Billing here is prepaid and non-recurring (a purchase buys a flat 30-day
  // period; nothing auto-charges again) — there is no subscription to
  // "cancel" in the Stripe-style sense. This flag records that the user has
  // stated they don't intend to manually renew, purely so the UI/notification
  // copy can say "moving to Free on <date>" instead of "renew before <date>
  // to keep your benefits." It does not itself change entitlement: reverting
  // an expired plan to Free happens unconditionally once subscriptionExpiresAt
  // passes, whether or not the user ever set this flag (see api/internal/sweep).
  subscriptionCancelAtPeriodEnd Boolean           @default(false)
  bio                           String?           @db.Text
  socialLinks                   Json? // { twitter?, instagram?, youtube?, website? }
  isBanned                      Boolean           @default(false)
  bannedReason                  String?
  // Bumped on ban, password reset and "sign out everywhere"; JWTs carrying an
  // older version are rejected on the next request instead of living 7 days.
  tokenVersion                  Int               @default(0)
  lastSeenAt                    DateTime?
  marketingOptOut               Boolean           @default(false)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  accounts              Account[]
  sessions              Session[]
  listings              Listing[]              @relation("SellerListings")
  offersMade            Offer[]                @relation("BuyerOffers")
  escrowsAsBuyer        Escrow[]               @relation("BuyerEscrows")
  escrowsAsSeller       Escrow[]               @relation("SellerEscrows")
  sentMessages          Message[]              @relation("SentMessages")
  notifications         Notification[]
  transactions          Transaction[]
  cryptoWallets         CryptoWallet[]
  auditLogs             AdminAuditLog[]        @relation("AdminActor")
  twoFactorAuth         TwoFactorAuth?
  webauthnCredentials   WebAuthnCredential[]
  activeSessions        ActiveSession[]
  reviewsGiven          Review[]               @relation("ReviewsGiven")
  reviewsReceived       Review[]               @relation("ReviewsReceived")
  reportsFiled          Report[]               @relation("ReportsFiled")
  watchlist             Watchlist[]
  achievementBadges     UserAchievementBadge[]
  phoneVerification     PhoneVerification?
  emailOtpVerification  EmailOtpVerification?
  marketingEmailLogs    MarketingEmailLog[]
  kycSubmissions        KycSubmission[]
  termsAcceptances      TermsAcceptance[]
  dataExportRequests    DataExportRequest[]
  dataErasureRequests   DataErasureRequest[]
  cookieConsent         CookieConsent?
  deviceFingerprints    DeviceFingerprint[]
  riskScore             RiskScore?
  securityFlags         SecurityFlag[]
  savedSearches         SavedSearch[]
  fiatPayments          FiatPayment[]
  displayCurrency       String                 @default("USD")
  referralCode          ReferralCode?
  referredByReferral    Referral?
  promoRedemptions      PromoRedemption[]
  referralCookie        String?
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  pushSubscriptions     PushSubscription[]
  expoPushToken         String? // Expo push token for mobile app
  // Onboarding & geo (Area 4+5)
  countryCode           String?                @db.VarChar(2)
  primaryIntent         PrimaryIntent?
  sellIntentPlatforms   Json? // string[] of Platform enum values
  sellReason            SellReason?
  onboardingCompletedAt DateTime?
  notifPrefs            Json? // { [NotificationType]: { email: boolean, inApp: boolean } }
  listingViewEvents     ListingViewEvent[]
  // M4
  ownedOrgs             Organization[]         @relation("OwnedOrgs")
  orgMemberships        OrganizationMember[]   @relation("OrgMemberships")
  auctionBids           AuctionBid[]           @relation("AuctionBids")
  privateInvites        PrivateListingInvite[] @relation("PrivateInvites")
  wantedListings        WantedListing[]        @relation("WantedListings")
  following             UserFollow[]           @relation("Following")
  followers             UserFollow[]           @relation("Followers")
  activityEvents        ActivityEvent[]        @relation("ActivityEvents")
  npsResponses          NpsResponse[]          @relation("NpsResponses")
  developerApps         AppListing[]           @relation("DeveloperApps")
  installedApps         AppInstallation[]      @relation("InstalledApps")
  bankTransferOrders    BankTransferOrder[]
  staffRoleId           String?
  staffRole             StaffRole?             @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  sentStaffInvites      StaffInvite[]          @relation("StaffInviter")
  supportTickets        SupportTicket[]        @relation("TicketOwner")
  assignedTickets       SupportTicket[]        @relation("TicketAssignee")
  supportMessages       SupportTicketMessage[]

  @@index([role])
}

model Listing {
  id                        String         @id @default(cuid())
  sellerId                  String
  seller                    User           @relation("SellerListings", fields: [sellerId], references: [id])
  platform                  Platform
  accountUrl                String
  title                     String
  description               String         @db.Text
  price                     Decimal        @db.Decimal(12, 2)
  followers                 Int?
  engagementRate            Float?
  accountAgeMonths          Int?
  monetized                 Boolean        @default(false)
  lifetimeViews             Int?
  lifetimeRevenue           Decimal?       @db.Decimal(12, 2)
  channelRpm                Decimal?       @db.Decimal(8, 2)
  audienceLanguage          String?
  channelCreationDate       DateTime?
  strikeCount               Int            @default(0)
  warningCount              Int            @default(0)
  strikeWarningContext      String?        @db.Text
  adsenseStatus             AdsenseStatus?
  displayName               String?
  accountLogo               String? // Cloudinary URL of account avatar/logo
  niche                     String? // e.g. "Gaming", "Islamic", "Fitness", "Finance"
  screenshots               Json // string[] of Cloudinary URLs
  ownershipVerificationCode String?
  ownershipVerified         Boolean        @default(false)
  ownershipMethod           String? // OAUTH_GOOGLE | OAUTH_TWITTER | OAUTH_FACEBOOK | BIO_CODE_AUTO | BIO_CODE_MANUAL
  ownershipVerifiedAt       DateTime?
  verifiedPlatformId        String? // confirmed channel/account ID returned by the platform
  status                    ListingStatus  @default(DRAFT)
  moderationScore           Int            @default(0)
  rejectionReason           String?
  viewCount                 Int            @default(0)
  isFeatured                Boolean        @default(false)
  isPremiumFeatured         Boolean        @default(false)
  isPinned                  Boolean        @default(false)
  featuredUntil             DateTime?
  pinnedUntil               DateTime?
  lastBumpedAt              DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  approvedAt                DateTime?
  soldAt                    DateTime?

  // M4: auction + private + org attribution
  saleType        SaleType      @default(FIXED)
  isPrivate       Boolean       @default(false)
  auctionEndsAt   DateTime?
  reservePrice    Decimal?      @db.Decimal(12, 2)
  buyNowPrice     Decimal?      @db.Decimal(12, 2)
  minBidIncrement Decimal?      @db.Decimal(12, 2)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  offers         Offer[]
  escrows        Escrow[]
  watchlist      Watchlist[]
  viewEvents     ListingViewEvent[]
  bids           AuctionBid[]
  privateInvites PrivateListingInvite[]
  messages       Message[]

  @@index([status, platform])
  @@index([sellerId])
  @@index([saleType, status])
  @@fulltext([title, description])
}

// NOTE: the underlying `Offer` table also has a `pendingDedupeKey` STORED
// GENERATED column + unique index, added by migration
// 20260916163500_offer_pending_dedupe_constraint, enforcing at most one
// PENDING offer per (listingId, buyerId) at the database level. It is
// deliberately NOT declared as a field here — MySQL rejects explicit writes
// to GENERATED ALWAYS columns, and Prisma has no native way to mark a field
// read-only/generated, so modeling it risks a future write attempt breaking
// at runtime. Do not drop/rename `listingId`, `buyerId`, or `status` on this
// model without also reviewing that migration.
model Offer {
  id            String      @id @default(cuid())
  listingId     String
  listing       Listing     @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User        @relation("BuyerOffers", fields: [buyerId], references: [id])
  sellerId      String // denormalized, avoids join for auth checks
  amount        Decimal     @db.Decimal(12, 2)
  message       String?     @db.Text
  status        OfferStatus @default(PENDING)
  parentOfferId String?
  parent        Offer?      @relation("OfferChain", fields: [parentOfferId], references: [id])
  children      Offer[]     @relation("OfferChain")
  round         Int         @default(1)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  escrow            Escrow?
  chatOfferMessages Message[] @relation("ChatOfferMessages")

  @@index([listingId, buyerId, status])
  @@index([sellerId, status])
}

model Escrow {
  id                 String       @id @default(cuid())
  listingId          String
  listing            Listing      @relation(fields: [listingId], references: [id])
  offerId            String?      @unique
  offer              Offer?       @relation(fields: [offerId], references: [id])
  buyerId            String
  buyer              User         @relation("BuyerEscrows", fields: [buyerId], references: [id])
  sellerId           String
  seller             User         @relation("SellerEscrows", fields: [sellerId], references: [id])
  amount             Decimal      @db.Decimal(12, 2) // negotiated price, seller receives this
  feeAmount          Decimal      @db.Decimal(12, 2)
  totalCharged       Decimal      @db.Decimal(12, 2) // amount + feeAmount, debited from buyer
  status             EscrowStatus @default(FUNDED)
  cryptoNetwork      String?
  ownershipEmail     String? // YouTube-only: Gmail to receive channel ownership
  credentialsPayload String?      @db.Text // encrypted account handoff details
  transferDeadline   DateTime?
  fundedAt           DateTime?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  transferStartedAt  DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  isHighValue                  Boolean   @default(false)
  videoVerificationRequired    Boolean   @default(false)
  videoVerificationCompletedAt DateTime?

  // Advanced transfer workflow
  transferModel             TransferModel?
  managerEmailId            String?             @unique
  managerEmail              EscrowManagerEmail? @relation(fields: [managerEmailId], references: [id])
  managerAddedAt            DateTime?
  buyerManagerAddedAt       DateTime?
  countdownEndsAt           DateTime?
  escrowOwnerPromotedAt     DateTime?
  sellerConfirmedHandoverAt DateTime?
  verifiedBy                String?

  // M4: org-attributed escrow
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  messages     Message[]
  dispute      Dispute?
  transactions Transaction[]
  reviews      Review[]
  milestones   EscrowMilestone[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model Dispute {
  id                    String        @id @default(cuid())
  escrowId              String        @unique
  escrow                Escrow        @relation(fields: [escrowId], references: [id])
  openedById            String
  status                DisputeStatus @default(OPEN)
  phase                 DisputePhase  @default(EVIDENCE)
  // Escrow status at the moment the dispute was opened. Closing a dispute
  // "without action" restores it: DISPUTED has no outbound transitions, so an
  // escrow whose dispute was closed used to be frozen with the funds held.
  escrowStatusBefore    EscrowStatus?
  reason                String        @db.Text
  resolution            String?       @db.Text
  adminNotes            String?       @db.Text
  evidenceDeadline      DateTime?
  mediationOffer        Decimal?      @db.Decimal(12, 2)
  mediationCounterOffer Decimal?      @db.Decimal(12, 2)
  mediationAccepted     Boolean?
  appealedAt            DateTime?
  appealReason          String?       @db.Text
  appealReviewedAt      DateTime?
  appealDecision        String?       @db.Text
  createdAt             DateTime      @default(now())
  resolvedAt            DateTime?

  evidence DisputeEvidence[]
  timeline DisputeTimeline[]

  // The admin disputes-list query filters by status and sorts by createdAt —
  // previously this model had zero indexes (only the implicit unique on
  // escrowId), meaning that query full-scanned as dispute volume grew.
  @@index([status, createdAt])
}

model DisputeEvidence {
  id          String   @id @default(cuid())
  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  userId      String
  statement   String   @db.Text
  attachments Json?
  submittedAt DateTime @default(now())

  @@index([disputeId])
  @@index([disputeId, userId])
}

model DisputeTimeline {
  id          String   @id @default(cuid())
  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  eventType   String
  actorId     String?
  description String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([disputeId, createdAt])
}

model Message {
  id                String    @id @default(cuid())
  conversationId    String // sorted "userIdA_userIdB", or "escrow_<id>"
  senderId          String
  sender            User      @relation("SentMessages", fields: [senderId], references: [id])
  recipientId       String
  escrowId          String?
  escrow            Escrow?   @relation(fields: [escrowId], references: [id])
  listingId         String?
  listing           Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  chatOfferId       String?
  chatOffer         Offer?    @relation("ChatOfferMessages", fields: [chatOfferId], references: [id], onDelete: SetNull)
  content           String    @db.Text
  attachmentUrl     String?
  attachmentName    String?
  isRead            Boolean   @default(false)
  isArchived        Boolean   @default(false)
  moderationFlagged Boolean   @default(false)
  isPinned          Boolean   @default(false)
  pinnedAt          DateTime?
  pinnedById        String?
  createdAt         DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@index([recipientId, isRead])
  @@index([escrowId, isPinned])
  @@index([chatOfferId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(12, 2) // always positive; type gives direction
  balanceBefore   Decimal           @db.Decimal(12, 2)
  balanceAfter    Decimal           @db.Decimal(12, 2)
  escrowId        String?
  escrow          Escrow?           @relation(fields: [escrowId], references: [id])
  cryptoPaymentId String?           @unique // NOWPayments payment_id, idempotency key
  metadata        Json?
  createdAt       DateTime          @default(now())

  @@index([userId, type])
  @@index([status])
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   @unique
  displayName   String?
  description   String?  @db.Text
  features      Json     @default("[]") // string[] — bullet points shown on pricing page
  badge         String? // e.g. "Most Popular", "Best Value"
  color         String   @default("#6366f1")
  isActive      Boolean  @default(true)
  isPopular     Boolean  @default(false)
  priceMonthly  Decimal  @db.Decimal(12, 2)
  priceAnnual   Decimal? @db.Decimal(12, 2)
  trialDays     Int      @default(0)
  listingLimit  Int
  maxEscrows    Int      @default(0) // 0 = unlimited concurrent escrows
  escrowFeeRate Decimal  @db.Decimal(6, 4)
  minFee        Decimal  @db.Decimal(12, 2)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  users User[]
}

model CryptoWallet {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  network       String // TRC20 | BEP20 | ERC20 | POLYGON | SOLANA
  address       String?
  paymentId     String?   @unique // NOWPayments payment_id
  status        String    @default("waiting") // waiting|confirming|confirmed|failed|rejected
  amountUsd     Decimal   @db.Decimal(12, 2)
  amountCrypto  Decimal?  @db.Decimal(24, 8)
  currency      String
  isManual      Boolean   @default(false)
  txHash        String? // manual deposit tx hash
  proofImageUrl String? // manual deposit screenshot
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?

  @@index([userId])
  @@index([status])
}

model PlatformSettings {
  id                                String    @id @default("singleton")
  siteName                          String    @default("AccsMarkets")
  maintenanceMode                   Boolean   @default(false)
  maintenanceTitle                  String?
  maintenanceMessage                String?   @db.Text
  maintenanceEndTime                DateTime?
  maintenanceAllowAdmins            Boolean   @default(true)
  registrationOpen                  Boolean   @default(true)
  requireEmailVerification          Boolean   @default(true)
  minDeposit                        Decimal   @default(10) @db.Decimal(12, 2)
  minWithdrawal                     Decimal   @default(20) @db.Decimal(12, 2)
  escrowTransferDays                Int       @default(3)
  disputeWindowHours                Int       @default(48)
  highValueEscrowThreshold          Decimal   @default(500) @db.Decimal(12, 2)
  officialSupportUserId             String?
  listingReviewHours                Int       @default(48)
  bankTransferShortfallToleranceUsd Decimal   @default(1.0) @db.Decimal(12, 2)
  bankTransferShortfallTolerancePct Float     @default(0.01)
  walletAddressTrc20                String?
  walletAddressBep20                String?
  walletAddressErc20                String?
  walletAddressMatic                String?
  walletAddressSol                  String?
  updatedAt                         DateTime  @updatedAt
}

model PlatformTransferPolicy {
  id                     String   @id @default(cuid())
  platform               String   @unique
  transferDays           Int      @default(3)
  policyNote             String?  @db.Text
  allowTrustless         Boolean  @default(false)
  trustlessBootstrapDays Int      @default(7)
  sourceNote             String?  @db.Text
  updatedAt              DateTime @updatedAt
}

model EscrowManagerEmail {
  id               String                   @id @default(cuid())
  address          String                   @unique
  platform         String
  status           EscrowManagerEmailStatus @default(AVAILABLE)
  notes            String?                  @db.Text
  addedAsManagerAt DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  escrow Escrow?

  @@index([platform, status])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminActor", fields: [adminId], references: [id])
  action     String // e.g. "listing.approve", "deposit.confirm"
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}

model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Infra-only, backs src/lib/rate-limit.ts
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------- Phase 2: Account security ----------

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String // AES-256-GCM encrypted TOTP secret
  backupCodes String   @db.Text // JSON array of bcrypt-hashed codes
  enabledAt   DateTime @default(now())
}

// A registered WebAuthn platform authenticator (Face ID / Touch ID / Windows
// Hello) — one row per enrolled device. Login challenges themselves are
// short-lived and kept in a signed cookie, not a table, so nothing here
// needs cleanup for expired attempts.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url credential ID from the authenticator
  publicKey    String    @db.Text // base64url COSE public key
  counter      BigInt    @default(0) // signature counter, replay protection
  deviceType   String? // "singleDevice" | "multiDevice" (passkey sync status)
  backedUp     Boolean   @default(false)
  transports   String? // comma-separated, e.g. "internal,hybrid"
  name         String? // user-facing label, e.g. "iPhone Face ID"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model ActiveSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?  @db.Text
  ip         String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ---------- Phase 3: Trust & content ----------

model Review {
  id         String   @id @default(cuid())
  escrowId   String
  escrow     Escrow   @relation(fields: [escrowId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
