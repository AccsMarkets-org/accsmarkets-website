# Database
DATABASE_URL="mysql://user:pass@localhost:3306/accsmarkets"

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@accsmarkets.org"
ADMIN_EMAIL="admin@accsmarkets.org"
ADMIN_PASSWORD="change-me-strong-password"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# NOWPayments
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# hCaptcha
HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""

# App
NODE_ENV="development"
PORT="3000"

# Encryption key for escrow credential payloads (32-byte hex, e.g. `openssl rand -hex 32`)
CREDENTIALS_ENCRYPTION_KEY=""

# Internal sweep endpoint secret (generate with: openssl rand -hex 32)
# Called by an external cron: POST /api/internal/sweep  -H "x-sweep-secret: <value>"
# Suggested schedule: every 15 minutes  */15 * * * *
INTERNAL_SWEEP_SECRET=""

# Redis (optional — enables Redis rate limiting, Socket.IO multi-instance, BullMQ job queue)
# Leave blank to run without Redis (DB-backed rate limiting, direct email, cron-based sweeps)
REDIS_URL=""

# Gemini AI (for blog generation)
GEMINI_API_KEY=""

# Blog automation cron (generate with: openssl rand -hex 32)
# Triggered by scripts/run-blog-cron.ps1 (Windows Scheduled Task "AccsMarkets Blog Cron"),
# NOT by vercel.json's crons block - Vercel cron never fires on this Windows deployment.
CRON_SECRET=""
BLOG_AUTO_PUBLISH="false"

# Sweep secret for /api/sweep endpoint
SWEEP_SECRET=""

# Set to "true" only once WhatsApp business verification + the OTP template
# are approved — otherwise phone verification stays optional so nobody is
# locked out of listing/buying/chat over a channel they can't complete yet.
PHONE_VERIFICATION_REQUIRED="false"

# WhatsApp Business Cloud API (optional — enables the Marketing > WhatsApp panel)
# Official Meta platform, NOT an unofficial WhatsApp Web automation library.
# Get from business.facebook.com: create an app -> add WhatsApp product ->
# verify a business phone number -> generate a permanent access token.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Set when registering the webhook URL in Meta Business Manager (any random string you choose)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App secret, used to verify inbound webhook signatures (optional but recommended)
WHATSAPP_APP_SECRET=""
# Signup phone verification (WhatsApp OTP) — requires an approved "Authentication"
# category template in WhatsApp Manager with one {{1}} body variable for the code.
WHATSAPP_OTP_TEMPLATE_NAME="otp_verification"
WHATSAPP_OTP_TEMPLATE_LANG="en_US"

# Brevo (optional — enables the Marketing > Email panel)
# Get from app.brevo.com/settings/keys/api. Sender email must be a verified
# sender/domain in Brevo (Settings > Senders, Domains & Dedicated IPs).
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@accsmarkets.org"
BREVO_SENDER_NAME="AccsMarkets"

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@accsmarkets.org"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Stripe card deposits — superseded by TagadaPay below (the `stripe` package
# was never installed, so this path is dead/dark regardless of these vars).
# Kept only because POST /api/wallet/deposit/card and /api/webhooks/stripe
# still exist server-side; the DepositWidget Card tab no longer uses them.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook secret: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# TagadaPay card deposits (optional — enables the Card tab in DepositWidget,
# and "Pay the difference with card" at escrow checkout). Dark by default:
# with TAGADA_API_KEY unset, getTagada() in src/lib/tagada.ts returns null,
# both /api/wallet/deposit/tagada and /api/webhooks/tagada fail closed (503),
# and the client falls back to the existing card→USDT onramp guide.
# Get keys from app.tagadapay.com → Settings → API Keys.
TAGADA_API_KEY="tp_sk_test_xxxxxxxx"
TAGADA_STORE_ID=""
# Webhook secret for the endpoint registered as POST /api/webhooks/tagada
# (tagada.webhooks.create with eventTypes incl. "payment/succeeded"/"payment/failed")
TAGADA_WEBHOOK_SECRET=""
# Client-side flags — NEXT_PUBLIC_* is inlined at build time and safe to read
# directly in the browser. Set the first to "true" once the vars above are
# configured; set the second only for a tp_sk_test_ key, to show a UI badge.
NEXT_PUBLIC_TAGADA_ENABLED="false"
NEXT_PUBLIC_TAGADA_TEST_MODE="false"

# Apple Pay / Google Pay express buttons (src/components/wallet/DigitalWalletButtons.tsx)
# — both dark by default, independently of NEXT_PUBLIC_TAGADA_ENABLED above.
# Both wallets tokenize through BasisTheory (TagadaPay's tokenization provider),
# NOT through TagadaPay's own API keys, so a separate public key is required.
#
# Get NEXT_PUBLIC_BASISTHEORY_API_KEY / NEXT_PUBLIC_BASISTHEORY_TENANT_ID from
# app.basistheory.com (the tenant TagadaPay provisioned for this account —
# ask TagadaPay support for it if it isn't visible under Settings > API Keys).
NEXT_PUBLIC_BASISTHEORY_API_KEY=""
NEXT_PUBLIC_BASISTHEORY_TENANT_ID=""

# Apple Pay — requires TagadaPay to have completed Apple Pay domain
# verification for this exact domain (app.tagadapay.com → Settings → Domains;
# this is what "we already added this domain with tagada" refers to) AND a
# public-restricted Tagada key (`tp_pk_live_...` / `tp_pk_test_...`, NOT the
# secret TAGADA_API_KEY above) from app.tagadapay.com → Settings → API Keys.
# NEXT_PUBLIC_TAGADA_STORE_ID is the same store as TAGADA_STORE_ID — store IDs
# aren't secret, but it needs its own NEXT_PUBLIC_ copy to reach the browser.
NEXT_PUBLIC_TAGADA_STORE_ID=""
NEXT_PUBLIC_TAGADA_PUBLIC_KEY=""
NEXT_PUBLIC_APPLE_PAY_ENABLED="false"

# Google Pay — merchant ID from pay.google.com/business/console. Any
# placeholder value works while NEXT_PUBLIC_TAGADA_TEST_MODE="true" (Google's
# TEST environment doesn't validate it); a real registration is required
# before flipping test mode off.
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=""
NEXT_PUBLIC_GOOGLE_PAY_ENABLED="false"
